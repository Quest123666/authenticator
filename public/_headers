/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://datasets-server.huggingface.co https://open.er-api.com https://api.allorigins.win https://api.codetabs.com https://corsproxy.io https://api.cors.lol https://wise.com https://www.xe.com; media-src 'none'; manifest-src 'self'; worker-src 'self'
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache
